{
  "Version": "5.0.2",
  "ReleaseNotes": "Conecta4G 3.1.0: configurações por operadora e UUID Xray pessoal. Use o APK 3.1.0 ou superior.",
  "UrlUpdate": "https://raw.githubusercontent.com/TaisonDS/Conecta4gg/refs/heads/main/config.json",
  "CheckUser": "false",
  "UrlContato": "",
  "EmailFeedback": "",
  "UrlTermos": "",
  "Sms": "",
  "Udp": [
    {
      "Porta": "7300"
    }
  ],
  "Servers": [
    {
      "Name": "SSH — Servidor 01 (exemplo)",
      "TYPE": "premium",
      "FLAG": "br.png",
      "ServerIP": "ssh.example.com",
      "ServerPort": "22",
      "SSLPort": "443",
      "CheckUser": "",
      "USER": "",
      "PASS": ""
    }
  ],
  "Networks": [
    {
      "Name": "TIM · SSH direto",
      "FLAG": "",
      "Payload": "",
      "SNI": "",
      "TlsIP": "",
      "ProxyIP": "",
      "ProxyPort": "22",
      "Info": "Direct",
      "Operator": "TIM"
    },
    {
      "Name": "CLARO · SSH + SSL/TLS",
      "FLAG": "",
      "Payload": "",
      "SNI": "[app_host]",
      "TlsIP": "",
      "ProxyIP": "",
      "ProxyPort": "",
      "Info": "Ssl",
      "Operator": "CLARO"
    },
    {
      "Name": "VIVO · SSH + proxy HTTP + payload",
      "FLAG": "",
      "Payload": "CONNECT [host_port] HTTP/1.1[crlf]Host: [host_port][crlf]Proxy-Connection: Keep-Alive[crlf][crlf]",
      "SNI": "",
      "TlsIP": "",
      "ProxyIP": "proxy.example.com",
      "ProxyPort": "8080",
      "Info": "Proxy",
      "Operator": "VIVO"
    },
    {
      "Name": "TIM · SSH + SSL + payload",
      "FLAG": "",
      "Payload": "GET /ssh HTTP/1.1[crlf]Host: [app_host][crlf]Connection: Upgrade[crlf]Upgrade: websocket[crlf][crlf]",
      "SNI": "[app_host]",
      "TlsIP": "[app_host]",
      "ProxyIP": "",
      "ProxyPort": "",
      "Info": "Tlsws",
      "Operator": "TIM"
    },
    {
      "Name": "CLARO · Proxy + payload com instant_split",
      "FLAG": "",
      "Payload": "CONNECT [host_port] HTTP/1.1[crlf][instant_split]Host: [host_port][crlf]Proxy-Connection: Keep-Alive[crlf][crlf]",
      "SNI": "",
      "TlsIP": "",
      "ProxyIP": "proxy.example.com",
      "ProxyPort": "8080",
      "Info": "Proxy",
      "Operator": "CLARO"
    },
    {
      "Name": "VIVO · SSL + payload com rotação",
      "FLAG": "",
      "Payload": "GET /ssh HTTP/1.1[crlf]Host: [rotate=edge-a.example.com;edge-b.example.com][crlf]Connection: Upgrade[crlf]Upgrade: websocket[crlf][crlf]",
      "SNI": "[app_host]",
      "TlsIP": "[app_host]",
      "ProxyIP": "",
      "ProxyPort": "",
      "Info": "Tlsws",
      "Operator": "VIVO"
    }
  ],
  "XrayProfiles": [
    {
      "Name": "TIM · VLESS + XHTTP + TLS (exemplo)",
      "Uri": "vless://[UUID]@xray.example.com:443?encryption=none&security=tls&sni=xray.example.com&fp=chrome&type=xhttp&host=xray.example.com&path=%2Fxhttp&mode=auto&alpn=h2#VLESS-XHTTP",
      "Operator": "TIM",
      "UseUserUuid": true
    },
    {
      "Name": "CLARO · VLESS + HTTPUpgrade + TLS (exemplo)",
      "Uri": "vless://[UUID]@xray.example.com:443?encryption=none&security=tls&sni=xray.example.com&vcn=xray.example.com&fp=chrome&type=httpupgrade&host=xray.example.com&path=%2Fhttpupgrade#VLESS-HTTPUpgrade",
      "Operator": "CLARO",
      "UseUserUuid": true
    },
    {
      "Name": "VIVO · VLESS + WebSocket + TLS (exemplo)",
      "Uri": "vless://[UUID]@xray.example.com:443?encryption=none&security=tls&sni=xray.example.com&fp=chrome&type=ws&host=xray.example.com&path=%2Fvless&alpn=http%2F1.1#VLESS-WebSocket",
      "Operator": "VIVO",
      "UseUserUuid": true
    },
    {
      "Name": "TIM · VMess + XHTTP + TLS (exemplo)",
      "Uri": "vmess://[UUID]@vmess.example.com:443?security=tls&sni=vmess.example.com&fp=chrome&type=xhttp&host=vmess.example.com&path=%2Fxhttp&mode=auto&alpn=h2&scy=auto#VMess-XHTTP",
      "Operator": "TIM",
      "UseUserUuid": true
    },
    {
      "Name": "CLARO · VMess + WebSocket + TLS (exemplo)",
      "Uri": "vmess://[UUID]@vmess.example.com:443?security=tls&sni=vmess.example.com&fp=chrome&type=ws&host=vmess.example.com&path=%2Fvmess&alpn=http%2F1.1&scy=auto#VMess-WebSocket",
      "Operator": "CLARO",
      "UseUserUuid": true
    },
    {
      "Name": "VIVO · VMess + WebSocket + TLS (exemplo)",
      "Operator": "VIVO",
      "UseUserUuid": true,
      "Uri": "vmess://[UUID]@vmess-vivo.example.com:443?security=tls&sni=vmess-vivo.example.com&type=ws&host=vmess-vivo.example.com&path=%2Fvmess&alpn=http%2F1.1&scy=auto#Vivo-VMess"
    }
  ]
}
